# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Your Project → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server-only, never expose to the client

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Dashboard → Developers → API keys / Webhooks, and Products for the price IDs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=
NEXT_PUBLIC_STRIPE_PRO_YEARLY_PRICE_ID=
NEXT_PUBLIC_STRIPE_ELITE_PRICE_ID=
NEXT_PUBLIC_STRIPE_ELITE_YEARLY_PRICE_ID=

# ─── Broker token encryption ────────────────────────────────────────────────
BROKER_TOKEN_ENCRYPTION_KEY=      # 32 bytes, base64-encoded

# ─── Email / newsletter ─────────────────────────────────────────────────────
RESEND_API_KEY=
NEWSLETTER_UNSUB_SECRET=          # HMAC secret for unsubscribe links
SANITY_WEBHOOK_SECRET=            # verifies the Sanity blog-publish webhook

# ─── AI / market data ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
POLYGON_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=

# ─── Ops ────────────────────────────────────────────────────────────────────
CRON_SECRET=                      # guards /api/cron/* endpoints
ADMIN_EMAILS=                     # comma-separated list of admin emails
